{
  "manifest_version": 2,
  "name": "Vandy Tasks",
  "description": "Weekly to-do sidebar for Vanderbilt Brightspace.",
  "version": "1.0.0",
  "icons": {
    "128": "icon-128.png"
  },
  "browser_action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    "icon-128.png",
    "custom-vandy-logo.png",
    "options.html"
  ],
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "permissions": ["storage", "https://brightspace.vanderbilt.edu/*"],
  "background": {
    "scripts": ["background.bundle.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://brightspace.vanderbilt.edu/*"],
      "js": ["contentScript.bundle.js"],
      "css": ["content.styles.css"],
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true,
    "browser_style": true,
    "chrome_style": false
  }
}
